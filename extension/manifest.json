{
  "manifest_version": 3,
  "name": "Jarvis · Tab übernehmen",
  "version": "0.1.0",
  "description": "Übergibt nur nach Klick einen ausgewählten Tab als lokale Jarvis-Aufgabe.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" }
    }
  },
  "action": {
    "default_title": "Tab an Jarvis übergeben",
    "default_popup": "popup.html"
  }
}
