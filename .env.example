# Kopiere diese Datei nach .env. Niemals echte Schlüssel einchecken.
# Standard: %LOCALAPPDATA%\JarvisLocal (Windows), außerhalb des Repositories.
# JARVIS_DATA_DIR=C:\Pfad\zu\privaten\Daten
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_PROVIDER=ollama
# Optionaler Anzeigename für das persönliche Schreibprofil (Standard: Mein Stil).
# JARVIS_PERSONAL_STYLE_LABEL=Mein Stil
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_VOICESTUDIO_URL=http://127.0.0.1:3900
JARVIS_VOICESTUDIO_MODEL=tts-1
JARVIS_VOICESTUDIO_VOICE=default
# JARVIS_VOICESTUDIO_API_KEY=lokaler-VoiceStudio-Schlüssel-falls-konfiguriert
JARVIS_OLLAMA_MODEL=qwen3:4b-instruct
# Optional: kleineres lokales Modell nur für die Wahl lesender Chat-Werkzeuge.
# Vorher `ollama pull qwen3:1.7b` ausführen; Antworten bleiben beim obigen Modell.
# JARVIS_OLLAMA_PLANNER_MODEL=qwen3:1.7b
# Optional für bewusst gewählte Bilder im Chat; vorher lokal mit Ollama installieren.
# JARVIS_OLLAMA_VISION_MODEL=moondream:1.8b
# Windows-Hotkey; bei Konflikt z. B. CTRL+SHIFT+J wählen.
JARVIS_HOTKEY=CTRL+ALT+J
# Für eine bewusst aktivierte OpenRouter-Nutzung:
# JARVIS_PROVIDER=openrouter
# Schlüssel im Windows-Tresor unter openrouter/default/api_key oder als Prozessvariable setzen.
# Niemals einen echten Schlüssel in dieser Datei speichern.
# JARVIS_OPENROUTER_MODEL=openai/gpt-4o-mini
JARVIS_DAILY_BUDGET_USD=1.00
JARVIS_MAX_OUTPUT_TOKENS=1024
JARVIS_MAX_CONTEXT_CHARS=24000
JARVIS_OLLAMA_CONTEXT_TOKENS=8192
JARVIS_MAX_STEPS=8
